
# Multi-Agent Data Analyst — Environment Variables
# Copy this file to .env and fill in the values.
# Required vars are marked with [REQUIRED], others have sensible defaults.

# --- Application ---
APP_NAME="Multi-Agent Data Analyst"
APP_ENV=development                    # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-string  # [REQUIRED] Used for signing

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000   # Comma-separated CORS origins

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Groq LLM (Optional — system works without it in rule-based mode) ---
GROQ_API_KEY=                          # Get from https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile    # Default model for analyst/explainer

# --- Clerk Auth ---
CLERK_SECRET_KEY=                      # [REQUIRED] From Clerk dashboard
CLERK_WEBHOOK_SECRET=                  # [REQUIRED] For webhook signature verification
CLERK_JWKS_URL=                        # Auto-derived from Clerk domain
CLERK_ISSUER_URL=

# --- File Storage ---
STORAGE_BACKEND=local                  # local | s3
STORAGE_LOCAL_PATH=./storage           # Local filesystem path
# S3 settings (only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# --- Rate Limiting ---
FREE_TIER_MONTHLY_LIMIT=10            # Reports per month for free users
MAX_FILE_SIZE_MB=25                    # Maximum upload file size

# --- Logging ---
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | console
